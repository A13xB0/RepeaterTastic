{
  "extends": "@vue/tsconfig/tsconfig.json",
  "include": ["vite.config.ts", "mock/**/*.ts", "src/api/types.ts"],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "lib": ["ES2023"],
    "types": ["node"],
    "noUnusedLocals": true,
    "noUnusedParameters": true
  }
}
