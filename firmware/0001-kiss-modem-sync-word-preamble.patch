diff --git a/docs/kiss_modem_protocol.md b/docs/kiss_modem_protocol.md
index 3f4dbf9c..7177e2da 100644
--- a/docs/kiss_modem_protocol.md
+++ b/docs/kiss_modem_protocol.md
@@ -118,6 +118,9 @@ MeshCore-specific functionality uses the standard KISS SetHardware command. The
 | Reboot          | `0x18` | -                                        |
 | SetSignalReport | `0x19` | Enable (1): 0x00=disable, nonzero=enable |
 | GetSignalReport | `0x1A` | -                                        |
+| SetSyncWord     | `0x1B` | Sync word (1)                            |
+| SetPreamble     | `0x1C` | Symbols (2, uint16 LE): 0 or 6-65535     |
+| GetPhyExtra     | `0x1D` | -                                        |
 
 ### Response Sub-commands (TNC to Host)
 
@@ -147,6 +150,7 @@ Response codes use the high-bit convention: `response = command | 0x80`. Generic
 | DeviceName   | `0x96` | Name (variable, UTF-8)                  |
 | Pong         | `0x97` | -                                       |
 | SignalReport | `0x9A` | Status (1): 0x00=disabled, 0x01=enabled |
+| PhyExtra     | `0x9D` | Sync word (1) + Preamble symbols (2)    |
 | OK           | `0xF0` | -                                       |
 | Error        | `0xF1` | Error code (1)                          |
 | TxDone       | `0xF8` | Result (1): 0x00=failed, 0x01=success   |
@@ -192,6 +196,44 @@ All values little-endian.
 | Version  | 1 byte | Firmware version |
 | Reserved | 1 byte | Always 0         |
 
+| Version | Changes                                                        |
+|---------|----------------------------------------------------------------|
+| 1       | Initial release                                                |
+| 2       | Adds SetSyncWord (`0x1B`), SetPreamble (`0x1C`), GetPhyExtra (`0x1D`) |
+
+Hosts should check for version >= 2 before using the PHY override commands; older firmware answers them with `Error` / `UnknownCmd`.
+
+### Sync Word (SetSyncWord)
+
+| Field     | Size   | Description                                            |
+|-----------|--------|--------------------------------------------------------|
+| Sync word | 1 byte | LoRa sync word in RadioLib single-byte form            |
+
+Default is `0x12` (MeshCore / LoRa "private"). `0x34` is the LoRaWAN public sync word, `0x2B` is used by Meshtastic. The value is applied with RadioLib `setSyncWord()` for the radio chip (SX126x: register `0x0740` = `0xY4 0xZ4` for sync `0xYZ`, e.g. `0x24 0xB4` for `0x2B`; SX127x: register `0x39`; LR11x0 / LR2021: LoRa sync word command). Responds `OK` on success, `Error` + `InvalidParam` if the radio rejected the value, `Error` + `TxBusy` if a transmission is in progress. The setting is kept until reboot (not persisted to flash) and survives later SetRadio calls.
+
+### Preamble Length (SetPreamble)
+
+All values little-endian.
+
+| Field   | Size    | Description                                                  |
+|---------|---------|--------------------------------------------------------------|
+| Symbols | 2 bytes | uint16_t preamble length in symbols: 6-65535, or 0 = default |
+
+By default MeshCore selects the preamble length from the spreading factor (32 symbols for SF <= 8, 16 otherwise) and re-applies it on every SetRadio. A non-zero value overrides this and persists across later SetRadio calls until reboot or until 0 is sent. Airtime estimates (GetAirtime, TX timeouts) and the receive header timeouts use the effective preamble length. Responds `OK` on success, `Error` + `InvalidParam` for 1-5 or a value the radio rejected, `Error` + `InvalidLength` if fewer than 2 bytes are supplied, `Error` + `TxBusy` if a transmission is in progress.
+
+### PHY Extra (PhyExtra response)
+
+All values little-endian.
+
+| Field     | Size    | Description                                         |
+|-----------|---------|-----------------------------------------------------|
+| Sync word | 1 byte  | Current LoRa sync word                              |
+| Preamble  | 2 bytes | uint16_t effective preamble length in symbols       |
+
+The preamble value is the length currently in effect (the override if one is set, otherwise the SF-derived default).
+
+Changing the sync word or preamble puts the radio into standby and restarts receive; a packet arriving at that moment may be lost. Configure the PHY before queueing traffic.
+
 ### Encrypted (Encrypted response)
 
 | Field      | Size     | Description                                    |
@@ -285,5 +327,6 @@ Data returned in CayenneLPP format. See [CayenneLPP documentation](https://docs.
 - All multi-byte values are little-endian unless stated otherwise
 - SNR values in RxMeta are multiplied by 4 for 0.25 dB precision
 - TxDone is sent as a SetHardware event after each transmission
+- Sync word, preamble, radio parameters and TX power are not stored in flash; the host must re-send them after every reboot/reconnect
 - Standard KISS clients receive only type 0x00 data frames and can safely ignore all SetHardware (0x06) frames
 - See [packet_format.md](./packet_format.md) for packet format
diff --git a/examples/kiss_modem/KissModem.cpp b/examples/kiss_modem/KissModem.cpp
index 2c770d98..58a7803f 100644
--- a/examples/kiss_modem/KissModem.cpp
+++ b/examples/kiss_modem/KissModem.cpp
@@ -20,6 +20,9 @@ KissModem::KissModem(Stream& serial, mesh::LocalIdentity& identity, mesh::RNG& r
   _setTxPowerCallback = nullptr;
   _getCurrentRssiCallback = nullptr;
   _getStatsCallback = nullptr;
+  _setSyncWordCallback = nullptr;
+  _setPreambleCallback = nullptr;
+  _getPhyExtraCallback = nullptr;
   _config = {0, 0, 0, 0, 0};
   _signal_report_enabled = true;
   resetOutputQueue();
@@ -381,6 +384,15 @@ void KissModem::handleHardwareCommand(uint8_t sub_cmd, const uint8_t* data, uint
     case HW_CMD_GET_SIGNAL_REPORT:
       handleGetSignalReport();
       break;
+    case HW_CMD_SET_SYNC_WORD:
+      handleSetSyncWord(data, len);
+      break;
+    case HW_CMD_SET_PREAMBLE:
+      handleSetPreamble(data, len);
+      break;
+    case HW_CMD_GET_PHY_EXTRA:
+      handleGetPhyExtra();
+      break;
     default:
       writeHardwareError(HW_ERR_UNKNOWN_CMD);
       break;
@@ -732,3 +744,60 @@ void KissModem::handleGetSignalReport() {
   uint8_t val = _signal_report_enabled ? 0x01 : 0x00;
   writeHardwareFrame(HW_RESP(HW_CMD_GET_SIGNAL_REPORT), &val, 1);
 }
+
+void KissModem::handleSetSyncWord(const uint8_t* data, uint16_t len) {
+  if (len < 1) {
+    writeHardwareError(HW_ERR_INVALID_LENGTH);
+    return;
+  }
+  if (!_setSyncWordCallback) {
+    writeHardwareError(HW_ERR_NO_CALLBACK);
+    return;
+  }
+  if (_tx_state == TX_SENDING) {
+    writeHardwareError(HW_ERR_TX_BUSY);
+    return;
+  }
+  if (!_setSyncWordCallback(data[0])) {
+    writeHardwareError(HW_ERR_INVALID_PARAM);
+    return;
+  }
+  writeHardwareFrame(HW_RESP_OK, nullptr, 0);
+}
+
+void KissModem::handleSetPreamble(const uint8_t* data, uint16_t len) {
+  if (len < 2) {
+    writeHardwareError(HW_ERR_INVALID_LENGTH);
+    return;
+  }
+  if (!_setPreambleCallback) {
+    writeHardwareError(HW_ERR_NO_CALLBACK);
+    return;
+  }
+  uint16_t symbols = (uint16_t)data[0] | ((uint16_t)data[1] << 8);
+  if (symbols != 0 && symbols < KISS_MIN_PREAMBLE_SYMBOLS) {
+    writeHardwareError(HW_ERR_INVALID_PARAM);
+    return;
+  }
+  if (_tx_state == TX_SENDING) {
+    writeHardwareError(HW_ERR_TX_BUSY);
+    return;
+  }
+  if (!_setPreambleCallback(symbols)) {
+    writeHardwareError(HW_ERR_INVALID_PARAM);
+    return;
+  }
+  writeHardwareFrame(HW_RESP_OK, nullptr, 0);
+}
+
+void KissModem::handleGetPhyExtra() {
+  if (!_getPhyExtraCallback) {
+    writeHardwareError(HW_ERR_NO_CALLBACK);
+    return;
+  }
+  uint8_t sync_word = 0;
+  uint16_t preamble = 0;
+  _getPhyExtraCallback(&sync_word, &preamble);
+  uint8_t buf[3] = { sync_word, (uint8_t)(preamble & 0xFF), (uint8_t)(preamble >> 8) };
+  writeHardwareFrame(HW_RESP(HW_CMD_GET_PHY_EXTRA), buf, 3);
+}
