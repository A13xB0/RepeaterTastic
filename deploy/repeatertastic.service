[Unit]
Description=RepeaterTastic virtual Meshtastic nodes
Documentation=https://github.com/ScotMesh/RepeaterTastic
After=network-online.target
Wants=network-online.target

# RepeaterTastic runs its nodes as meshtasticd instances (2.8.0 or newer). deploy/install.sh
# installs the meshtasticd package and keeps the package's own service off, which would take the
# radio and port 4403:
#   systemctl disable --now meshtasticd
# To run them in Docker instead (hosted.docker_image), install.sh --meshtasticd docker adds the
# docker group in a drop-in (repeatertastic.service.d/docker.conf).

[Service]
Type=simple
User=repeatertastic
Group=repeatertastic
SupplementaryGroups=dialout
ExecStart=/usr/local/bin/repeatertastic -config /etc/repeatertastic/repeatertastic.yaml
Restart=on-failure
RestartSec=5
StateDirectory=repeatertastic
StateDirectoryMode=0700
ConfigurationDirectory=repeatertastic

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/repeatertastic /etc/repeatertastic
DeviceAllow=char-ttyUSB rw
DeviceAllow=char-ttyACM rw
# The spi driver: a CH341 USB adapter, or a Pi HAT on SPI and GPIO (add the spi and gpio groups).
DeviceAllow=char-usb_device rw
DeviceAllow=char-spidev rw
DeviceAllow=char-gpiochip rw
DevicePolicy=closed

[Install]
WantedBy=multi-user.target
